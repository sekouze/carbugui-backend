# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1
APP_KEY=

# Database (MySQL)
DATABASE_URL="mysql://user:password@host:3306/carbugui"
DIRECT_URL="mysql://user:password@host:3306/carbugui"

# Seed (bootstrap admin account created by `npm run seed`)
SEED_ADMIN_PHONE=+224610000000
SEED_ADMIN_PASSWORD=change-me

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# SMS (NimbaSMS)
SMS_API_URL=https://api.nimbasms.com/v1
SMS_API_KEY=

# Email (SMTP)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
SYSTEM_EMAIL=
